# =============================================================================
# Omni-Modal Enterprise Research Orchestrator — environment configuration
# =============================================================================
# Copy this file to .env and fill in the values for your setup.
# NEVER commit your real .env — it is in .gitignore.
#
# Reading guide:
#   [REQUIRED]        Must be set — the system will not work without it.
#   [REQUIRED IF]     Required only when a specific feature is enabled.
#   [OPTIONAL]        Has a safe default; only set it to override.
#   [INTERFACE ONLY]  Read by the health endpoint only; not used at runtime.
#   SECRET            Keep private — do not log, print, or commit.
#   FREE              No paid service required.
#   PAID              Requires a paid or usage-billed external account.
#
# Cheapest working local setup (zero paid services):
#   - Set JWT_SECRET to any random string (openssl rand -hex 32)
#   - Leave everything else at its default or empty
#   - Embeddings use the offline hashing fallback automatically
#   - Retrieval uses the in-memory store — no Postgres needed
#   - Sentry and A2A delegation are disabled
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND — AUTHENTICATION                                            [REQUIRED]
# SECRET  FREE
# -----------------------------------------------------------------------------
# Shared HMAC-SHA256 secret used to sign and verify JWT tokens.
# Used by: services/api (every authenticated request), scripts/issue_jwt.py
# How to generate a strong secret:
#   openssl rand -hex 32          (Linux/macOS)
#   python -c "import secrets; print(secrets.token_hex(32))"   (any platform)
# Keep this identical in your backend env and when running issue_jwt.py.




# -----------------------------------------------------------------------------
# BACKEND — DATABASE                                           [OPTIONAL / FREE]
# Unset = in-memory demo path (no Postgres needed for local dev)
# -----------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension.
# Used by: PgVectorChunkRetriever, PostgresMcpRepository, ConnectionPool
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=...
# How to get:
#   - Local:  install Postgres + pgvector, or use Docker (see README)
#   - Cloud:  Neon free tier — https://neon.tech (free, has pgvector)
#             Supabase free tier — https://supabase.com
# Leave empty to run fully offline using the in-memory vector store.
DATABASE_URL=""

# Connection pool size (used only when DATABASE_URL is set)
DB_POOL_MIN="2"     # [OPTIONAL] default: 2
DB_POOL_MAX="10"    # [OPTIONAL] default: 10

# Row-Level Security enforcement (defense-in-depth tenant isolation).
# Off by default. Set to "true" ONLY after applying migration 0008_rls.sql
# (python scripts/migrate.py). When on, tenant-scoped data-plane queries bind
# app.tenant_id so Postgres enforces tenant isolation even if an app-layer
# WHERE clause is ever missed. See docs/operations.md section 2.
RLS_ENFORCEMENT="false"


# -----------------------------------------------------------------------------
# BACKEND — EMBEDDING BACKEND SELECTION                          [OPTIONAL/FREE]
# Default: hashing (deterministic, offline, zero dependencies)
# -----------------------------------------------------------------------------
# Which embedding provider to use. The system NEVER requires OpenAI.
#
# hashing (default)
#   - Deterministic bag-of-words, offline, zero cost, zero dependencies.
#   - Retrieval ranks by token overlap, NOT semantic meaning.
#   - Use for: local dev, demo, CI, cost-free deployment.
#   - Measured quality: recall@1 = 0.40 on paraphrase corpus.
#
# sentence-transformers  (local semantic, FREE, no API key)
#   - Real semantic embeddings, runs fully offline after model download (~90MB).
#   - Install: pip install sentence-transformers
#   - Compatible with the in-memory retrieval path (384 dims by default).
#   - NOTE: pgvector column is vector(1536); use a 1536-dim model or leave
#     DATABASE_URL empty (in-memory path handles any dimension).
#   - Use for: portfolio demo with real semantic quality, no cost.
#
# openai  (cloud semantic, PAID, requires OPENAI_API_KEY)
#   - Real semantic embeddings via OpenAI REST API (~$0.02 / 1M tokens).
#   - 1536 dims — compatible with BOTH in-memory and pgvector paths.
#   - Use for: production or when you need top retrieval quality.
EMBEDDING_BACKEND="hashing"

# Embedding vector dimensions. Must match the DATABASE_URL schema if pgvector
# is used. Default 1536 matches the OpenAI models and the SQL migration.
EMBEDDING_DIMENSIONS="1536"

# [REQUIRED IF EMBEDDING_BACKEND=openai]  SECRET  PAID
# Get at: https://platform.openai.com/api-keys
# Cost: ~$0.02 per 1M tokens (text-embedding-3-small)
OPENAI_API_KEY=""

# OpenAI embedding model to use.  [OPTIONAL]  default: text-embedding-3-small
# Options: text-embedding-3-small (1536d), text-embedding-3-large (3072d)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# OpenAI API base URL.  [OPTIONAL]  default: https://api.openai.com/v1
# Override for Azure OpenAI or a local proxy.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Sentence-transformers model name.  [OPTIONAL]
# default: BAAI/bge-small-en-v1.5 (384 dims, strong retrieval, query-prefix
# handled automatically in code). Alternatives: thenlper/gte-small (384, no
# prefix), sentence-transformers/all-MiniLM-L6-v2 (384, weaker).
# For pgvector, apply migration 0004_embeddings_384.sql so the column is 384-dim.
SENTENCE_TRANSFORMERS_MODEL="BAAI/bge-small-en-v1.5"


# -----------------------------------------------------------------------------
# BACKEND — OBSERVABILITY (Sentry)                              [OPTIONAL  PAID]
# Both vars are optional; leaving them empty disables Sentry silently.
# -----------------------------------------------------------------------------
# Backend Python Sentry DSN.
# Get at: https://sentry.io → Project → Settings → Client Keys (DSN)
# Free tier available (up to 5k events/mo).
SENTRY_DSN=""

# Fraction of transactions to trace (0.0–1.0).  [OPTIONAL]  default: 0.1
SENTRY_TRACES_SAMPLE_RATE="0.1"


# -----------------------------------------------------------------------------
# BACKEND — RUNTIME SETTINGS                                       [OPTIONAL]
# -----------------------------------------------------------------------------
# Deployment environment tag (shown in Sentry events).  default: development
ENVIRONMENT="development"

# Set false to disable the in-process LRU+TTL query result cache.
QUERY_CACHE_ENABLED="true"


# -----------------------------------------------------------------------------
# BACKEND — REDIS (horizontal scaling)                      [OPTIONAL / FREE TIER]
# Unset (default) = in-process rate limiter + cache + ingestion queue
#                   (single instance only — perfect for local dev / demo).
# Set REDIS_URL    = distributed sliding-window rate limiter, shared query cache,
#                   and a durable ingestion queue with a separable worker tier.
#                   This is what makes the web tier stateless and horizontally
#                   scalable. Every component falls back to in-process if Redis
#                   becomes unreachable, so setting this never reduces uptime.
# Requires: pip install -e '.[scale]'   (adds the 'redis' client)
# How to get (free, no card): https://upstash.com → create database → copy the
#   "rediss://default:<password>@<host>:<port>" connection string.
# Local alternative: docker run -p 6379:6379 redis  →  redis://localhost:6379
# -----------------------------------------------------------------------------
REDIS_URL=""

# When REDIS_URL is set, the web process also runs an in-process consumer by
# default. Set this to "false" ONLY when you deploy a separate worker service
# (python -m omni_modal.ingestion.redis_worker) so the web tier stays stateless.
INGEST_WORKER_IN_PROCESS="true"


# -----------------------------------------------------------------------------
# LLM ANSWER GENERATION (Phase F) — Google Gemini             [OPTIONAL  FREE TIER]
# When GEMINI_API_KEY is set (and LLM_ANSWER_GENERATION_ENABLED != false), the
# query path generates a grounded answer with inline citations from retrieved
# chunks. When unset, the system falls back to extractive (chunk-return)
# answers so the offline/demo path keeps working.
# Get a key at: https://aistudio.google.com/app/apikey  (free tier available)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
LLM_ANSWER_GENERATION_ENABLED="true"

# Groq (free tier, fast, OpenAI-compat) — takes priority over Gemini when set.
# Get a free key (no card) at: https://console.groq.com
# Models: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"


# -----------------------------------------------------------------------------
# AUTH (Phase E) — Auth.js (NextAuth) credentials provider              [FREE]
# AUTH_SECRET signs Auth.js session cookies/JWTs. Generate: openssl rand -hex 32
# The backend keeps verifying its own API JWT (JWT_SECRET) independently.
# -----------------------------------------------------------------------------
AUTH_SECRET=""

# Token lifecycle (Phase 2 hardening). Access tokens are short-lived JWTs;
# refresh tokens are long-lived, server-stored, rotated on every use, and
# revocable (see /auth/refresh, /auth/logout). Refresh tokens live in Redis
# when REDIS_URL is set (shared + revocable across instances), else in-process.
ACCESS_TOKEN_TTL_SECONDS="900"          # [OPTIONAL] default: 900 (15 min)
REFRESH_TOKEN_TTL_SECONDS="2592000"     # [OPTIONAL] default: 2592000 (30 days)


# -----------------------------------------------------------------------------
# BACKEND — EXTERNAL AI DELEGATION (A2A)       [OPTIONAL  PAID/EXPERIMENTAL]
# Both are checked; either one enables the HttpA2AResearchClient.
# Unset (default) = DisabledExternalResearchClient — delegation is a no-op.
# -----------------------------------------------------------------------------
# A2A / Gemini Interactions endpoint URL.
# Format: https://your-a2a-endpoint/...
A2A_DELEGATION_ENDPOINT=""
GEMINI_INTERACTIONS_ENDPOINT=""


# -----------------------------------------------------------------------------
# WHISPER TRANSCRIPTION — wired into LocalWhisperTranscriber          [OPTIONAL FREE]
# Set to a model size or full path. Whisper binary must be on PATH.
# Options: tiny (~39MB), base (~74MB), small (~244MB), medium (~769MB), large
# "base" is recommended for demos (good quality, reasonable speed).
# Leave empty to use the whisper binary with its default model.
# -----------------------------------------------------------------------------
WHISPER_MODEL_PATH="base"

# -----------------------------------------------------------------------------
# ENTITY EXTRACTION — wired into the entity extraction service     [OPTIONAL FREE]
# HuggingFace model ID or local path for a PRETRAINED NER model.
# "dslim/bert-base-NER" = free pre-trained NER, ~420MB, downloads once on first run.
# Leave empty to use the built-in rule-based extractor (zero deps, always works).
# NOTE: this loads a *pretrained* model — it is NOT a QLoRA fine-tune. A QLoRA
# training pipeline is scaffolded (omni_modal.entity_extraction.training) but
# produces no fine-tuned weights. Do not describe this as a trained QLoRA model.
# Requires: pip install transformers torch
# (Legacy alias QLORA_ENTITY_MODEL_PATH is still honoured for backward compat.)
# -----------------------------------------------------------------------------
ENTITY_NER_MODEL_PATH="dslim/bert-base-NER"

# -----------------------------------------------------------------------------
# ADK ORCHESTRATION                                                    [OPTIONAL FREE]
# The DeterministicAgentGraph is always active. This value identifies the
# deployment in health reports and observability traces.
# -----------------------------------------------------------------------------
ADK_PROJECT_ID="omero-local-dev"


# =============================================================================
# FRONTEND (Next.js)  — apps/web/.env.local
# =============================================================================
# NOTE: NEXT_PUBLIC_* vars are bundled into the browser JavaScript.
# Never put secrets in NEXT_PUBLIC_* vars.


# App display name shown in the browser tab.  [OPTIONAL]
NEXT_PUBLIC_APP_NAME="Omni-Modal Enterprise Research Orchestrator"

# Backend origin the BROWSER calls for /query/stream and /ingest/upload.
# For local dev this is http://localhost:8000.  [OPTIONAL]
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Dev/demo bearer token for the browser UI.
# Generate with: python scripts/issue_jwt.py --tenant demo --user u1 --roles researcher
# Required for the browser UI to make authenticated API calls.  SECRET
NEXT_PUBLIC_API_TOKEN=""

# Frontend Sentry DSN (bundled into browser JS).  [OPTIONAL  PAID]
# Can be the same DSN as SENTRY_DSN or a separate frontend project.
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry environment tag for frontend events.  [OPTIONAL]  default: development
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"


# =============================================================================
# FRONTEND SERVER-SIDE ONLY
# These are read by Next.js server components only, never sent to the browser.
# =============================================================================

# Backend URL for server-to-server calls (SSR).  [OPTIONAL]
BACKEND_BASE_URL="http://localhost:8000"

# Backend Sentry DSN configured?  [OPTIONAL]
# This is just a boolean presence check used in the server health helper.
SENTRY_DSN=""


# =============================================================================
# SAAS LAYER — optional integrations (all default to FREE local adapters)
# =============================================================================
# The SaaS layer (organizations, workspaces, usage metering, plans/billing,
# team invites, notifications, admin dashboard) works fully offline with
# in-memory stores and local adapters. None of the variables below are
# required. Each one, when set, swaps a local adapter for a real external
# service — and the system always falls back to the local adapter (with a log
# line) if the credential/library is missing. Nothing here charges money or
# requires an account to run the demo.

# -----------------------------------------------------------------------------
# FILE STORAGE — local filesystem (default) | S3-compatible (if S3_BUCKET set)
# [OPTIONAL]  Local is FREE. S3 is PAID (free-ish tiers exist on AWS/R2/MinIO).
# Requires: pip install boto3  (only when S3_BUCKET is set)
# -----------------------------------------------------------------------------
S3_BUCKET=""
S3_ENDPOINT_URL=""   # e.g. https://<account>.r2.cloudflarestorage.com for Cloudflare R2 / MinIO
S3_REGION=""

# -----------------------------------------------------------------------------
# EMAIL — console/log (default) | Resend (if RESEND_API_KEY set)
# [OPTIONAL]  Console is FREE. Resend has a free tier (external account).
# Used for: team invite emails, onboarding. Sent via stdlib urllib (no new dep).
# Get a key at: https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM="OMERO <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# PRODUCT ANALYTICS — in-memory (default) | PostHog (if POSTHOG_API_KEY set)
# [OPTIONAL]  In-memory is FREE. PostHog has a free tier (external account).
# Used for: admin dashboard event counts (query/upload/workspace/plan events).
# Get a key at: https://posthog.com
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# -----------------------------------------------------------------------------
# BILLING — demo mode (default) | Stripe (if STRIPE_SECRET_KEY set)
# [OPTIONAL]  Demo billing is FREE and applies plan changes instantly with no
# charge. Setting STRIPE_SECRET_KEY flips /billing into "stripe" mode with a
# real Checkout + Customer Portal flow (products/prices are auto-created in
# your Stripe account on first use). Requires: pip install stripe
# Get keys at: https://dashboard.stripe.com/test/apikeys (use test keys)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Stripe webhook signing secret (whsec_...). Optional for local dev — the
# /billing/confirm endpoint applies the plan on checkout return without it.
# Production: configure a webhook to POST /billing/webhook and set this.
# Local: `stripe listen --forward-to localhost:8000/billing/webhook`.
STRIPE_WEBHOOK_SECRET=""

# Frontend origin Stripe redirects back to after checkout / portal.
APP_BASE_URL="http://localhost:3000"
