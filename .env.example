# Public web configuration.
NEXT_PUBLIC_APP_NAME="Omni-Modal Research Orchestrator"

# Server-only web configuration. Do not expose DATABASE_URL to Next.js client code.
BACKEND_BASE_URL="http://localhost:8000"
SENTRY_DSN=""

# Python backend configuration.
ENVIRONMENT="development"
DATABASE_URL="postgresql://user:password@localhost:5432/omni_modal"

# Phase 1 placeholders. These are intentionally not wired yet.
WHISPER_MODEL_PATH=""
QLORA_ENTITY_MODEL_PATH=""
ADK_PROJECT_ID=""
A2A_DELEGATION_ENDPOINT=""
GEMINI_INTERACTIONS_ENDPOINT=""
